    "agent-builder": {
      "name": "agent-builder",
      "description": "Agent 构建与评审专家（套件辅助成员，不属于 SDLC 阶段；由用户或主会话按需调用）。给 Claude Code 子代理或对话式提示词做可复现的百分制合规打分（固定 6 维细则，每条扣分带行号证据），按扣分点优化存量 agent 并输出变更日志，或按需求生成新 agent；生成物按画像注入安全合规约束、记忆与知识模块（独立 agent 内嵌，套件成员引用共享协议）。评审本套件成员时按 shared_protocol 口径打分。",
      "tools": "Read, Write, Edit, Bash, Glob, Grep, WebFetch",
      "model": "sonnet",
      "color": "pink",
      "memory": "project"
    },
    "devops-engineer": {
      "name": "devops-engineer",
      "description": "通用 SDLC 运维工程师（GROUP_E1：PHASE_10 CI/CD、PHASE_11a 部署计划；GROUP_E2：PHASE_11b 部署执行）。E1 基于已批准设计与测试结果，产出 cicd_pipeline.md（阶段、环境矩阵、制品管理）与 deployment_plan.md（预检、策略、DEPLOY/ROLLBACK、验证），只用项目画像中存在的环境与部署方式。E2 仅在授权后执行并写部署报告，含回滚与回滚失败处理。由 pm-orchestrator 调用。",
      "tools": "Read, Write, Edit, Bash, Glob, Grep",
      "model": "sonnet",
      "color": "red",
      "memory": "project"
    },
    "kb-curator": {
      "name": "kb-curator",
      "description": "通用 SDLC 知识蒸馏员（PHASE_12，交付后由 pm-orchestrator 调用，也可单独运行）。读取经验收件箱、门控记录、缺陷与各 agent 记忆，去重合并、按证据计算置信度，把已验证经验晋升到各 agent 的项目记忆，淘汰过期或被反驳的条目，提出通用知识候选，写蒸馏报告与日志。",
      "tools": "Read, Write, Edit, Bash, Glob, Grep",
